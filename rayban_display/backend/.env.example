# Stesso formato di zeus/.env: endpoint OpenAI-compatibile (Groq, OpenAI, ecc.)
LLM_API_KEY=gsk_xxx
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=llama3-8b-8192

# Opzionale: se impostata, /agent/invoke richiede l'header X-API-Key
RAYBAN_BACKEND_API_KEY=

# Lunghezza massima del testo mostrato sul display degli occhiali
RAYBAN_DISPLAY_MAX_CHARS=220

# Quanti turni di conversazione tenere in memoria per session_id
RAYBAN_SESSION_HISTORY_TURNS=6
